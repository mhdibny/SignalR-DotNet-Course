@{
    ViewData["Title"] = "Home Page";
}
<style>
    .messages {
        max-width: 650px;
        margin: 24px auto;
        padding: 20px;
        background: linear-gradient(135deg, #EAF6FC, #fff);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(135, 206, 235, 0.3);
        font-family: 'vazirmatn', 'Shabnam', Tahoma, sans-serif;
    }

    .messages .form-control {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #87CEEB;
        border-radius: 10px;
        background: #fff;
        color: #1B3A4B;
        font-family: inherit;
        font-size: 15px;
        outline: none;
        box-shadow: none;
        transition: 0.3s;
    }

    .messages .form-control:focus {
        border-color: #4FA8D8;
        box-shadow: 0 0 0 4px rgba(135, 206, 235, 0.3);
    }

    .messages .form-control::placeholder {
        color: #8FA9B8;
    }

    .messages .form-control.my-2 {
        margin-bottom: 12px !important;
    }

    .btn-send {
        display: block;
        width: 100%;
        margin-top: 12px;
        padding: 12px 16px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #87CEEB, #4FA8D8);
        color: #fff;
        font-family: inherit;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(79, 168, 216, 0.35);
        transition: 0.3s;
    }

    .btn-send:hover {
        background: linear-gradient(135deg, #4FA8D8, #2E8BC0);
        box-shadow: 0 6px 16px rgba(79, 168, 216, 0.5);
        transform: translateY(-2px);
    }

    .btn-send:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(79, 168, 216, 0.4);
    }

    #message-container {
        list-style: none;
        padding: 0;
        margin: 0;
        overflow-y: auto;
    }

    #message-container p {
        color: #4FA8D8;
        font-weight: 700;
        border-bottom: 2px dashed #87CEEB;
        padding-bottom: 8px;
        margin-bottom: 12px;
    }

    #message-container li {
        background: #fff;
        border-left: 4px solid #87CEEB;
        border-radius: 8px;
        padding: 10px 14px;
        margin-bottom: 8px;
        color: #1B3A4B;
        box-shadow: 0 2px 6px rgba(135, 206, 235, 0.2);
        transition: 0.2s;
    }

    #message-container li:hover {
        transform: translateX(5px);
        border-left-color: #4FA8D8;
    }
</style>


<div class="row p-2 messages">
    <div class="row p-3">
        <input class="form-control my-2" placeholder="نام خود را وارد کنید." id="username-input"/>
        <input class="form-control my-2" placeholder="پیام خود را وارد کنید." id="message-input"/>
        <button id="send-btn" onclick="sendMessage()" class="btn-send">ارسال</button>
    </div>
    <ul id="message-container">
        <p>پیام ها:</p>
    </ul>
</div>

@section Scripts
{
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/site.js"></script>
}
